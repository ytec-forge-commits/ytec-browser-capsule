<Window x:Class="Ytec.BrowserCapsule.App.BackupOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バックアップの準備"
        Width="560"
        Height="570"
        MinWidth="520"
        MinHeight="540"
        KeyboardNavigation.TabNavigation="Cycle"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="#172B4D"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Text="バックアップの準備" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#5F7187"
                       FontSize="13"
                       LineHeight="20"
                       Text="保存する内容を選びます。バックアップと復元キーファイルは次の手順で自動作成します。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        Background="White"
                        BorderBrush="#DCE4EF"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock Foreground="#26384F"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="保存する内容" />
                        <CheckBox x:Name="SettingsCheckBox"
                                  Margin="0,14,0,0"
                                  Content="ブラウザー設定"
                                  IsChecked="True" />
                        <CheckBox x:Name="BookmarksCheckBox"
                                  Margin="0,10,0,0"
                                  Content="ブックマーク／お気に入り"
                                  IsChecked="True" />
                        <CheckBox x:Name="HistoryCheckBox"
                                  Margin="0,10,0,0"
                                  Content="履歴"
                                  IsChecked="True" />
                        <CheckBox x:Name="ExtensionsCheckBox"
                                  Margin="0,10,0,0"
                                  Content="拡張機能と設定"
                                  IsChecked="True" />
                        <CheckBox x:Name="SiteDataCheckBox"
                                  Margin="0,10,0,0"
                                  Content="Cookie／サイトデータ（別PCでは復元保証外）"
                                  IsChecked="True" />
                        <CheckBox x:Name="SessionsCheckBox"
                                  Margin="0,10,0,0"
                                  Content="セッション情報（通常は選択不要）" />
                        <CheckBox x:Name="PasswordCsvCheckBox"
                                   Margin="0,10,0,0"
                                  Content="保存パスワードCSV（公式画面でエクスポート）"
                                  IsChecked="True" />
                        <TextBlock Margin="24,5,0,0"
                                   Foreground="#87520A"
                                   FontSize="11"
                                   Text="ブラウザーの保護は回避せず、標準画面から保存したCSVだけを短時間取り込みます。"
                                   TextWrapping="Wrap" />
                        <Separator Margin="0,14,0,10" />
                        <CheckBox x:Name="FullProfileCheckBox"
                                  Checked="FullProfileCheckBox_Changed"
                                  Content="詳細: プロファイル全体（保存パスワードCSVは別選択）"
                                  Unchecked="FullProfileCheckBox_Changed" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#DCE4EF"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock Foreground="#26384F"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="復元キーファイル方式" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#6B7D91"
                                   FontSize="12"
                                   LineHeight="19"
                                   Text="文字入力は不要です。アプリがバックアップ専用の「.ybckey」を自動生成します。別PCではバックアップと復元キーの両方を選ぶだけで復元できます。"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="#FFF4DC"
                                CornerRadius="8">
                            <TextBlock Foreground="#754B08"
                                       FontSize="12"
                                       LineHeight="19"
                                       Text="復元キーはバックアップを開くための秘密情報です。紛失すると復元できません。盗難対策を高める場合は、完成後にバックアップとは別のUSBメモリ等へ保管してください。"
                                       TextWrapping="Wrap" />
                        </Border>
                        <CheckBox x:Name="AcknowledgementCheckBox"
                                  Margin="0,13,0,0"
                                  Content="復元キーも必ず保管することを確認しました"
                                  Checked="AcknowledgementCheckBox_Changed"
                                  Unchecked="AcknowledgementCheckBox_Changed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationText"
                           Margin="2,12,2,0"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="#B42318"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="92"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button x:Name="CreateButton"
                    Width="150"
                    Height="42"
                    Click="CreateButton_Click"
                    Content="次へ"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
