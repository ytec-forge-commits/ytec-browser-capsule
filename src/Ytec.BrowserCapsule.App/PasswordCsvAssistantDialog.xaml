<Window x:Class="Ytec.BrowserCapsule.App.PasswordCsvAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存パスワードCSVアシスタント"
        Width="650"
        Height="600"
        MinWidth="580"
        MinHeight="540"
        KeyboardNavigation.TabNavigation="Cycle"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Foreground="#172B4D"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Text="保存パスワードCSVを安全に追加" />
            <TextBlock x:Name="StepText"
                       Margin="0,8,0,0"
                       Foreground="#5F7187"
                       FontSize="13"
                       Text="準備しています…"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18"
                        Background="White"
                        BorderBrush="#DCE4EF"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock x:Name="BrowserNameText"
                                   Foreground="#172B4D"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ProfileNameText"
                                   Margin="0,5,0,0"
                                   Foreground="#52677F"
                                   FontSize="14" />
                        <Border Margin="0,14,0,0"
                                Padding="12"
                                Background="#FFF4DC"
                                CornerRadius="8">
                            <TextBlock Foreground="#754B08"
                                       FontSize="12"
                                       LineHeight="19"
                                       Text="本アプリは保存パスワードを直接読みません。開いたブラウザー標準画面でCSVをエクスポートし、下の専用フォルダーへ保存してください。"
                                       TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="OpenBrowserButton"
                                    Margin="0,0,8,8"
                                    Click="OpenBrowserButton_Click"
                                    Content="標準画面を開いて待機"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Margin="0,0,8,8"
                                    Click="OpenFolderButton_Click"
                                    Content="保存先フォルダーを開く"
                                    Style="{StaticResource QuietButtonStyle}" />
                            <Button Margin="0,0,0,8"
                                    Click="CopyPathButton_Click"
                                    Content="保存先パスをコピー"
                                    Style="{StaticResource QuietButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Margin="0,7,0,5"
                                   Foreground="#52677F"
                                   FontSize="12"
                                   Text="CSVの保存先" />
                        <TextBox x:Name="StagingPathTextBox"
                                 Padding="8"
                                 AutomationProperties.Name="CSVの一時保存先"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,14,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#DCE4EF"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock Foreground="#26384F"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="CSVの取り込み" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#6B7D91"
                                   FontSize="12"
                                   Text="標準画面を開くと自動で待機します。書き込み完了を確認し、形式検証後すぐ暗号化して平文削除を試みます。検出されない場合だけ下の再試行を使ってください。"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="DetectionProgressBar"
                                     Height="6"
                                     Margin="0,13,0,0"
                                     AutomationProperties.Name="CSV検出の進み具合"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,10,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="#38577C"
                                   FontSize="12"
                                   Text="CSVを保存したら取り込みを開始してください。"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CaptureButton"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Click="CaptureButton_Click"
                                Content="CSV検出を再試行"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton"
                    HorizontalAlignment="Left"
                    Click="SkipButton_Click"
                    Content="このプロファイルはスキップ"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Grid.Column="1"
                    Width="92"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button x:Name="ContinueButton"
                    Grid.Column="2"
                    Width="145"
                    Height="42"
                    Click="ContinueButton_Click"
                    Content="次へ"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
