<Window x:Class="Ytec.BrowserCapsule.App.PassphrasePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バックアップを開く"
        Width="500"
        Height="320"
        MinWidth="460"
        MinHeight="300"
        KeyboardNavigation.TabNavigation="Cycle"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Foreground="#172B4D"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Text="暗号化バックアップを開く" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#5F7187"
                       FontSize="13"
                       Text="これは旧BVB v1バックアップです。作成時に設定したパスフレーズを入力してください。パスフレーズは保存しません。"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1"
                Margin="0,20,0,18"
                Padding="18"
                Background="White"
                BorderBrush="#DCE4EF"
                BorderThickness="1"
                CornerRadius="11">
            <StackPanel>
                <TextBlock Foreground="#26384F"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="パスフレーズ" />
                <PasswordBox x:Name="PassphraseBox"
                             Height="40"
                             Margin="0,10,0,0"
                             Padding="9,6"
                             AutomationProperties.Name="バックアップのパスフレーズ"
                             PasswordChanged="PassphraseBox_Changed" />
                <TextBlock x:Name="ValidationText"
                           Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="#B42318"
                           FontSize="12" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="92"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button x:Name="OpenButton"
                    Width="130"
                    Height="42"
                    Click="OpenButton_Click"
                    Content="安全に開く"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
