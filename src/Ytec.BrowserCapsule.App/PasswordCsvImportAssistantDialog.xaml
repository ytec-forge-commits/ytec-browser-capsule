<Window x:Class="Ytec.BrowserCapsule.App.PasswordCsvImportAssistantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存パスワードの公式インポート"
        Width="720"
        Height="500"
        MinWidth="660"
        MinHeight="450"
        KeyboardNavigation.TabNavigation="Cycle"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Foreground="#172B4D"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Text="保存パスワードを公式画面から取り込む" />
            <TextBlock x:Name="StepText"
                       Margin="0,8,0,0"
                       Foreground="#5F7187"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1"
                Margin="0,20,0,18"
                Padding="18"
                Background="White"
                BorderBrush="#DCE4EF"
                BorderThickness="1"
                CornerRadius="11">
            <StackPanel>
                <TextBlock x:Name="BrowserNameText"
                           Foreground="#172B4D"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ProfileNameText"
                           Margin="0,5,0,0"
                           Foreground="#52677F"
                           FontSize="14" />
                <Border Margin="0,14,0,0"
                        Padding="12"
                        Background="#FFF4DC"
                        CornerRadius="8">
                    <TextBlock Foreground="#754B08"
                               FontSize="12"
                               LineHeight="19"
                               Text="標準のパスワード管理画面で「CSVからインポート」を選び、下の一時CSVを指定してください。本アプリはインポート成否を推測しません。"
                               TextWrapping="Wrap" />
                </Border>
                <WrapPanel Margin="0,14,0,0">
                    <Button Margin="0,0,8,8"
                            Click="OpenBrowserButton_Click"
                            Content="標準画面を開く"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="0,0,8,8"
                            Click="OpenFolderButton_Click"
                            Content="CSVの場所を開く"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button Margin="0,0,0,8"
                            Click="CopyPathButton_Click"
                            Content="フォルダーパスをコピー"
                            Style="{StaticResource QuietButtonStyle}" />
                </WrapPanel>
                <TextBox x:Name="CsvPathTextBox"
                         Margin="0,8,0,0"
                         Padding="8"
                         AutomationProperties.Name="インポートする一時CSVのパス"
                         IsReadOnly="True"
                         TextWrapping="Wrap" />
                <TextBlock x:Name="RecordCountText"
                           Margin="0,9,0,0"
                           Foreground="#52677F"
                           FontSize="12" />
                <TextBlock x:Name="StatusText"
                           Margin="0,10,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="#38577C"
                           FontSize="12"
                           Text="インポート後に下の完了ボタンを押すと、一時CSVを削除します。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left"
                    Click="SkipButton_Click"
                    Content="スキップしてCSVを削除"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Grid.Column="1"
                    Width="92"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Grid.Column="2"
                    Width="220"
                    Height="42"
                    Click="ImportedButton_Click"
                    Content="インポート完了・削除"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
