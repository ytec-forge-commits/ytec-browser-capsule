<Window x:Class="Ytec.BrowserCapsule.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Y-TEC Browser Capsule"
        Icon="Assets/YtecBrowserCapsule.ico"
        Width="1280"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        KeyboardNavigation.TabNavigation="Continue"
        WindowStartupLocation="CenterScreen"
        Background="#F7F5FF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="38,24,38,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Offset="0"
                                  Color="#25315B" />
                    <GradientStop Offset="0.58"
                                  Color="#463B83" />
                    <GradientStop Offset="1"
                                  Color="#6C5CE7" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="10,4"
                                Background="#514990"
                                CornerRadius="12">
                            <TextBlock Foreground="#F0ECFF"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="WINDOWS 10 / 11" />
                        </Border>
                        <TextBlock Margin="12,3,0,0"
                                   Foreground="#E5DEFF"
                                   FontSize="13"
                                   Text="3つのブラウザーを、かんたんに別PCへ" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Text="Y-TEC Browser Capsule" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="#F0EDFF"
                               FontSize="14"
                               Text="プロファイルを選ぶだけ。復元キーもアプリが自動で作ります。"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="24,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="ManualButton"
                                Margin="0,0,8,0"
                                AutomationProperties.HelpText="画面付きの操作マニュアルを既定のPDF閲覧アプリで開きます。"
                                AutomationProperties.Name="操作マニュアル"
                                Click="ManualButton_Click"
                                Content="操作マニュアル"
                                Style="{StaticResource QuietButtonStyle}"
                                ToolTip="画面付きPDFマニュアルを開く" />
                        <Button x:Name="SettingsButton"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="設定"
                                Click="SettingsButton_Click"
                                Content="設定"
                                Style="{StaticResource QuietButtonStyle}" />
                        <Button x:Name="AboutButton"
                                AutomationProperties.Name="このアプリについて"
                                Click="AboutButton_Click"
                                Content="このアプリについて"
                                Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button x:Name="RefreshButton"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="ブラウザーを再検出"
                                Click="RefreshButton_Click"
                                Content="↻  再検出"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="VerifyBackupButton"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="バックアップを検証"
                                Click="VerifyBackupButton_Click"
                                Content="バックアップを検証"
                                Style="{StaticResource QuietButtonStyle}" />
                        <Button x:Name="RestoreBackupButton"
                                AutomationProperties.Name="バックアップから復元"
                                Click="RestoreBackupButton_Click"
                                Content="バックアップから復元"
                                Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="34,20,34,12"
                Padding="18,14"
                Background="#FFFDFE"
                BorderBrush="#DED8F4"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#26384F"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="ブラウザーを確認しています…" />
                    <TextBlock x:Name="StatusDetailText"
                               Margin="0,4,0,0"
                               Foreground="#64748B"
                               FontSize="12"
                               Text="プロファイルの内容は変更しません。"
                               TextWrapping="Wrap" />
                    <CheckBox x:Name="IncludeOtherWindowsUsersCheckBox"
                              Margin="0,9,0,0"
                              AutomationProperties.HelpText="管理者権限を使わず、現在のユーザーから読み取れるブラウザープロファイルだけを追加します。"
                              AutomationProperties.Name="読み取り可能なほかのWindowsユーザーも表示"
                              Checked="IncludeOtherWindowsUsers_Changed"
                              Content="読み取り可能なほかのWindowsユーザーも表示"
                              Unchecked="IncludeOtherWindowsUsers_Changed" />
                    <ProgressBar x:Name="BackupProgressBar"
                                 Height="5"
                                 Margin="0,10,0,0"
                                 AutomationProperties.Name="バックアップまたは復元の進み具合"
                                 Maximum="100"
                                 Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="SelectAllButton"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="すべて選択"
                            Click="SelectAllButton_Click"
                            Content="すべて選択"
                            Style="{StaticResource QuietButtonStyle}" />
                    <Button x:Name="ClearSelectionButton"
                            AutomationProperties.Name="選択を解除"
                            Click="ClearSelectionButton_Click"
                            Content="選択を解除"
                            Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="34,0,34,12">
            <ScrollViewer x:Name="ProfilesScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BrowserGroupsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14"
                                    Padding="20"
                                    Background="#FFFDFE"
                                    BorderBrush="#DED8F4"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="8"
                                                Height="28"
                                                Margin="0,0,12,0"
                                                Background="{Binding AccentColor}"
                                                CornerRadius="4" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="#172B4D"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding BrowserName}" />
                                        <Border Grid.Column="2"
                                                Padding="9,4"
                                                Background="#EEF3F8"
                                                CornerRadius="9">
                                            <TextBlock Foreground="#52677F"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding ProfileCountText}" />
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,9"
                                                        Padding="15,13"
                                                        Background="#FAF9FF"
                                                        BorderBrush="#E7E1F7"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Margin="0,0,14,0"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="#1F2F46"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="7,2"
                                                                        Background="#DDF6E8"
                                                                        CornerRadius="7"
                                                                        Visibility="{Binding DefaultBadgeVisibility}">
                                                                    <TextBlock Foreground="#176B43"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Text="既定" />
                                                                </Border>
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="7,2"
                                                                        Background="#FFF0D6"
                                                                        CornerRadius="7"
                                                                        Visibility="{Binding FallbackBadgeVisibility}">
                                                                    <TextBlock Foreground="#87520A"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Text="推定検出" />
                                                                </Border>
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="7,2"
                                                                        Background="#FFE3E3"
                                                                        CornerRadius="7"
                                                                        Visibility="{Binding RunningBadgeVisibility}">
                                                                    <TextBlock Foreground="#9E2A2A"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Text="実行中" />
                                                                </Border>
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="7,2"
                                                                        Background="#E5EEFF"
                                                                        CornerRadius="7"
                                                                        Visibility="{Binding WindowsUserBadgeVisibility}">
                                                                    <TextBlock Foreground="#315A9B"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding WindowsUserText}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Margin="0,5,0,0"
                                                                       Foreground="#6B7D91"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       Text="{Binding DirectoryText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    Margin="18,0,0,0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock HorizontalAlignment="Right"
                                                                       Foreground="#26384F"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding SizeText}" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="#7A8A9C"
                                                                       FontSize="11"
                                                                       Text="{Binding SizeNote}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="EmptyStateBorder"
                    Padding="28"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#DCE4EF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="#26384F"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="プロファイルが見つかりませんでした" />
                    <TextBlock MaxWidth="620"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="14"
                               LineHeight="22"
                               Text="Chrome、Edge、Firefoxを一度起動してプロファイルを作成したあと、「再検出」を押してください。"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="BusyStateBorder"
                    Padding="28"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="#F3F0FF"
                    BorderBrush="#CFC5FF"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar Width="240"
                                 Height="7"
                                 AutomationProperties.Name="プロファイル検出の進み具合"
                                 IsIndeterminate="True" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="#38577C"
                               FontSize="14"
                               Text="プロファイルと容量を確認しています…" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="34,13"
                Background="White"
                BorderBrush="#DCE4EF"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionSummaryText"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="#1F2F46"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="0件を選択" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#74859A"
                               FontSize="11"
                               Text="フルパスや保存内容はこの画面に表示しません。" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           MaxWidth="430"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#6B7D91"
                           FontSize="11"
                               Text="実行中のブラウザーは、確認後にアプリから安全に終了できます。"
                           TextAlignment="Right"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="2"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="CancelBackupButton"
                            Margin="0,0,9,0"
                            Click="CancelBackupButton_Click"
                            Content="中止"
                            Style="{StaticResource QuietButtonStyle}"
                            Visibility="Collapsed" />
                    <Button x:Name="CreateBackupButton"
                            Click="CreateBackupButton_Click"
                            Content="バックアップを作成"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
