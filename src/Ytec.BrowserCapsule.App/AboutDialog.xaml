<Window x:Class="Ytec.BrowserCapsule.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y-TEC Browser Capsuleについて"
        Width="610"
        Height="540"
        MinWidth="480"
        MinHeight="480"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F4F7FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="28,24"
                Background="#172B4D">
            <StackPanel>
                <TextBlock Foreground="#9FC4FF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="WINDOWS 10 / 11 x64" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Text="Y-TEC Browser Capsule" />
                <TextBlock x:Name="VersionText"
                           Margin="0,5,0,0"
                           Foreground="#D4DEEC"
                           FontSize="13"
                           Text="バージョンを確認しています" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <TextBlock Foreground="#26384F"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="3つのブラウザーを、ひとつのカプセルへ" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#5E7188"
                           FontSize="13"
                           LineHeight="21"
                           Text="Chrome、Microsoft Edge、Firefoxの複数プロファイルを、専用の復元キーファイルで守る暗号化バックアップへまとめます。"
                           TextWrapping="Wrap" />

                <WrapPanel Margin="0,18,0,0">
                    <Border Margin="0,0,8,8"
                            Padding="10,5"
                            Background="#DDF6E8"
                            CornerRadius="9">
                        <TextBlock Foreground="#176B43"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="オフライン動作" />
                    </Border>
                    <Border Margin="0,0,8,8"
                            Padding="10,5"
                            Background="#E5EEFF"
                            CornerRadius="9">
                        <TextBlock Foreground="#315A9B"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="テレメトリーなし" />
                    </Border>
                    <Border Margin="0,0,8,8"
                            Padding="10,5"
                            Background="#FFF0D6"
                            CornerRadius="9">
                        <TextBlock Foreground="#87520A"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="Apache-2.0" />
                    </Border>
                </WrapPanel>

                <Border Margin="0,12,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#DCE4EF"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock Foreground="#26384F"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="保存パスワードの安全な扱い" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#5E7188"
                                   FontSize="12"
                                   LineHeight="19"
                                   Text="ブラウザーの保存パスワードを直接復号しません。各ブラウザーの公式画面で、ご本人がCSVのエクスポート／インポートを行います。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Foreground="#26384F"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="ライセンスと表示" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#5E7188"
                           FontSize="12"
                           LineHeight="19"
                           Text="本アプリのソースコードはApache License 2.0です。配布フォルダーのLICENSE、NOTICE、THIRD-PARTY-NOTICES.mdに、利用条件と表示を収録しています。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,14"
                Background="White"
                BorderBrush="#DCE4EF"
                BorderThickness="0,1,0,0">
            <Button Width="110"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="この画面を閉じる"
                    Click="CloseButton_Click"
                    Content="閉じる"
                    IsCancel="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Border>
    </Grid>
</Window>
